# Токен НОВОГО отдельного бота-диспетчера (создать через @BotFather).
# НЕ токен рабочих ботов "Расцветай" — этот бот только диспетчерит, сам
# рассылки подписчикам не шлёт.
DISPATCHER_BOT_TOKEN=

# Ваш личный Telegram ID (можно узнать у @userinfobot) — бот будет отвечать
# только вам, чтобы никто чужой не смог им воспользоваться.
OWNER_TELEGRAM_ID=
