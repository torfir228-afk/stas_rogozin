# Токен вашего бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-bot-token

# ID или @username канала, на который проверяется подписка.
# Бот ОБЯЗАТЕЛЬНО должен быть добавлен в этот канал администратором,
# иначе он не сможет проверять подписки пользователей.
CHANNEL_ID=@your_channel

# Публичная ссылка на канал — используется в кнопках и текстах "подписаться"
CHANNEL_URL=https://t.me/your_channel

# Ссылка на лид-магнит (видео/чек-лист), которую бот пришлёт после подписки
LEAD_MAGNET_URL=https://your-link-to-material

# (Необязательно) путь к локальному файлу лид-магнита внутри контейнера/сервера.
# Если указан — файл будет отправлен документом в Telegram в дополнение к ссылке.
LEAD_MAGNET_FILE_PATH=

# Через сколько минут отправлять напоминания, если пользователь не подписался
REMINDER_1_DELAY_MINUTES=10
REMINDER_2_DELAY_MINUTES=120

# Пути к файлам базы данных (можно не менять)
DB_PATH=data/bot.sqlite3
JOBS_DB_PATH=data/jobs.sqlite3
